-- WARNING: This schema is for context only and is not meant to be run.
-- Table order and constraints may not be valid for execution.

CREATE TABLE public.active_sessions (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  user_id uuid NOT NULL,
  user_agent text,
  ip_address text,
  last_active timestamp with time zone NOT NULL DEFAULT now(),
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT active_sessions_pkey PRIMARY KEY (id),
  CONSTRAINT active_sessions_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.users(id)
);
CREATE TABLE public.announcements (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  title character varying NOT NULL,
  content text NOT NULL,
  author_id uuid,
  created_at timestamp with time zone,
  is_public boolean DEFAULT true,
  target_user_ids ARRAY,
  committee_ids ARRAY,
  CONSTRAINT announcements_pkey PRIMARY KEY (id),
  CONSTRAINT announcements_author_id_fkey FOREIGN KEY (author_id) REFERENCES public.users(id)
);
CREATE TABLE public.application_forms (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  slug character varying NOT NULL UNIQUE,
  title character varying NOT NULL,
  description text,
  fee numeric NOT NULL DEFAULT 0,
  steps jsonb NOT NULL DEFAULT '[]'::jsonb,
  is_active boolean NOT NULL DEFAULT true,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT application_forms_pkey PRIMARY KEY (id)
);
CREATE TABLE public.applications (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  user_id uuid NOT NULL,
  status USER-DEFINED NOT NULL DEFAULT 'pending'::application_status_enum,
  submitted_at timestamp with time zone NOT NULL DEFAULT now(),
  reviewed_at timestamp with time zone,
  review_notes text,
  payment_status USER-DEFINED NOT NULL DEFAULT 'unpaid'::payment_status_enum,
  form_id uuid NOT NULL,
  form_data jsonb NOT NULL DEFAULT '{}'::jsonb,
  CONSTRAINT applications_pkey PRIMARY KEY (id),
  CONSTRAINT applications_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.users(id),
  CONSTRAINT applications_form_id_fkey FOREIGN KEY (form_id) REFERENCES public.application_forms(id)
);
CREATE TABLE public.catering_logs (
  id bigint GENERATED ALWAYS AS IDENTITY NOT NULL,
  user_id uuid,
  datetime timestamp with time zone,
  created_by uuid,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT catering_logs_pkey PRIMARY KEY (id),
  CONSTRAINT catering_database_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.users(id),
  CONSTRAINT catering_database_created_by_fkey FOREIGN KEY (created_by) REFERENCES public.users(id)
);
CREATE TABLE public.committee_documents (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  committee_id uuid NOT NULL UNIQUE,
  document_blob bytea,
  is_locked boolean DEFAULT false,
  updated_at timestamp with time zone,
  CONSTRAINT committee_documents_pkey PRIMARY KEY (id),
  CONSTRAINT committee_documents_committee_id_fkey FOREIGN KEY (committee_id) REFERENCES public.committees(id)
);
CREATE TABLE public.committee_members (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  committee_id uuid,
  user_id uuid,
  joined_at timestamp with time zone,
  can_write boolean DEFAULT false,
  CONSTRAINT committee_members_pkey PRIMARY KEY (id),
  CONSTRAINT committee_members_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.users(id),
  CONSTRAINT committee_members_committee_id_fkey FOREIGN KEY (committee_id) REFERENCES public.committees(id)
);
CREATE TABLE public.committees (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  name character varying NOT NULL,
  description text,
  admin_id uuid,
  created_at timestamp with time zone,
  updated_at timestamp with time zone,
  CONSTRAINT committees_pkey PRIMARY KEY (id),
  CONSTRAINT committees_admin_id_fkey FOREIGN KEY (admin_id) REFERENCES public.users(id)
);
CREATE TABLE public.document_versions (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  committee_id uuid NOT NULL,
  document_blob bytea NOT NULL,
  created_at timestamp with time zone DEFAULT now(),
  created_by uuid,
  version_name text,
  is_auto_save boolean DEFAULT false,
  CONSTRAINT document_versions_pkey PRIMARY KEY (id),
  CONSTRAINT document_versions_created_by_fkey FOREIGN KEY (created_by) REFERENCES public.users(id),
  CONSTRAINT document_versions_committee_id_fkey FOREIGN KEY (committee_id) REFERENCES public.committees(id)
);
CREATE TABLE public.email_verifications (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  email character varying NOT NULL,
  code character varying NOT NULL,
  expires_at timestamp with time zone NOT NULL,
  verified boolean DEFAULT false,
  created_at timestamp with time zone NOT NULL DEFAULT (now() AT TIME ZONE 'utc'::text),
  CONSTRAINT email_verifications_pkey PRIMARY KEY (id)
);
CREATE TABLE public.logs (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  user_id uuid,
  action character varying NOT NULL,
  details jsonb,
  ip_address character varying,
  user_agent character varying,
  created_at timestamp with time zone,
  severity USER-DEFINED DEFAULT 'info'::log_severity,
  category USER-DEFINED DEFAULT 'system'::log_category,
  resource_id uuid,
  resource_type text,
  CONSTRAINT logs_pkey PRIMARY KEY (id),
  CONSTRAINT logs_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.users(id)
);
CREATE TABLE public.observer_allocations (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  allocated_committee uuid,
  allocated_field text,
  field_observer boolean NOT NULL DEFAULT true,
  CONSTRAINT observer_allocations_pkey PRIMARY KEY (id),
  CONSTRAINT observer_allocations_id_fkey FOREIGN KEY (id) REFERENCES public.users(id),
  CONSTRAINT observer_allocations_allocated_committee_fkey FOREIGN KEY (allocated_committee) REFERENCES public.committees(id)
);
CREATE TABLE public.observer_tasks (
  id bigint GENERATED ALWAYS AS IDENTITY NOT NULL,
  assigned_by uuid,
  assigned_to uuid,
  assigned_task text,
  assigned_committee uuid,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  status USER-DEFINED NOT NULL DEFAULT 'created'::task_status_enum,
  task_description text,
  CONSTRAINT observer_tasks_pkey PRIMARY KEY (id),
  CONSTRAINT observer_tasks_assigned_by_fkey FOREIGN KEY (assigned_by) REFERENCES public.users(id),
  CONSTRAINT observer_tasks_assigned_to_fkey FOREIGN KEY (assigned_to) REFERENCES public.users(id),
  CONSTRAINT observer_tasks_assigned_committee_fkey FOREIGN KEY (assigned_committee) REFERENCES public.committees(id)
);
CREATE TABLE public.password_resets (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  email character varying NOT NULL,
  token_hash character varying NOT NULL,
  expires_at timestamp with time zone NOT NULL,
  created_at timestamp with time zone,
  used boolean DEFAULT false,
  CONSTRAINT password_resets_pkey PRIMARY KEY (id)
);
CREATE TABLE public.payment_receipts (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  user_id uuid NOT NULL,
  application_id uuid NOT NULL,
  storage_path text NOT NULL,
  file_type text,
  status USER-DEFINED NOT NULL DEFAULT 'pending'::receipt_status_enum,
  admin_note text,
  reviewed_by uuid,
  reviewed_at timestamp with time zone,
  created_at timestamp with time zone DEFAULT now(),
  CONSTRAINT payment_receipts_pkey PRIMARY KEY (id),
  CONSTRAINT payment_receipts_reviewed_by_fkey FOREIGN KEY (reviewed_by) REFERENCES public.users(id),
  CONSTRAINT payment_receipts_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.users(id),
  CONSTRAINT payment_receipts_application_id_fkey FOREIGN KEY (application_id) REFERENCES public.applications(id)
);
CREATE TABLE public.resources (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  title character varying NOT NULL,
  description text,
  file_url text NOT NULL,
  file_type character varying,
  category USER-DEFINED NOT NULL DEFAULT 'general'::resource_category_enum,
  uploaded_by uuid,
  is_public boolean DEFAULT false,
  created_at timestamp with time zone,
  committee_id uuid,
  storage_path text,
  CONSTRAINT resources_pkey PRIMARY KEY (id),
  CONSTRAINT resources_uploaded_by_fkey FOREIGN KEY (uploaded_by) REFERENCES public.users(id),
  CONSTRAINT resources_committee_id_fkey FOREIGN KEY (committee_id) REFERENCES public.committees(id)
);
CREATE TABLE public.roll_call_logs (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  roll_call_id uuid,
  user_id uuid,
  scanned_at timestamp with time zone,
  CONSTRAINT roll_call_logs_pkey PRIMARY KEY (id),
  CONSTRAINT roll_call_logs_roll_call_id_fkey FOREIGN KEY (roll_call_id) REFERENCES public.roll_calls(id),
  CONSTRAINT roll_call_logs_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.users(id)
);
CREATE TABLE public.roll_calls (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  committee_id uuid,
  session_name character varying NOT NULL,
  qr_code character varying NOT NULL UNIQUE,
  session_date timestamp with time zone,
  created_at timestamp with time zone,
  secret_key text,
  CONSTRAINT roll_calls_pkey PRIMARY KEY (id),
  CONSTRAINT roll_calls_committee_id_fkey FOREIGN KEY (committee_id) REFERENCES public.committees(id)
);
CREATE TABLE public.system_settings (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  applications_open boolean DEFAULT true,
  maintenance_mode boolean DEFAULT false,
  term_name character varying DEFAULT 'ATAGÇ 2026'::character varying,
  contact_email character varying DEFAULT 'info@atagc.com.tr'::character varying,
  updated_at timestamp with time zone,
  event_start_date timestamp with time zone,
  event_end_date timestamp with time zone,
  location text DEFAULT 'İTÜ GVO İzmir NESAN Yerleşkesi'::text,
  bank_name text DEFAULT 'Ziraat Bankası'::text,
  bank_account_holder text DEFAULT 'ATAGÇ Komitesi'::text,
  bank_iban text DEFAULT 'TR00 0000 0000 0000 0000 0000 00'::text,
  CONSTRAINT system_settings_pkey PRIMARY KEY (id)
);
CREATE TABLE public.ticket_messages (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  ticket_id uuid NOT NULL,
  sender_id uuid,
  is_staff_reply boolean NOT NULL DEFAULT false,
  message text NOT NULL,
  attachments ARRAY,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  CONSTRAINT ticket_messages_pkey PRIMARY KEY (id),
  CONSTRAINT feedback_messages_ticket_id_fkey FOREIGN KEY (ticket_id) REFERENCES public.tickets(id),
  CONSTRAINT feedback_messages_sender_id_fkey FOREIGN KEY (sender_id) REFERENCES public.users(id)
);
CREATE TABLE public.tickets (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  user_id uuid,
  is_anonymous boolean NOT NULL DEFAULT false,
  access_token uuid DEFAULT gen_random_uuid(),
  category USER-DEFINED NOT NULL DEFAULT 'general'::feedback_category_enum,
  subject character varying NOT NULL,
  status USER-DEFINED NOT NULL DEFAULT 'submitted'::feedback_status_enum,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  CONSTRAINT tickets_pkey PRIMARY KEY (id),
  CONSTRAINT feedback_tickets_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.users(id)
);
CREATE TABLE public.topics (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  committee_id uuid,
  title character varying NOT NULL,
  description text,
  created_at timestamp with time zone,
  updated_at timestamp with time zone,
  CONSTRAINT topics_pkey PRIMARY KEY (id),
  CONSTRAINT topics_committee_id_fkey FOREIGN KEY (committee_id) REFERENCES public.committees(id)
);
CREATE TABLE public.user_connections (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  requester_id uuid NOT NULL,
  recipient_id uuid NOT NULL,
  status USER-DEFINED NOT NULL DEFAULT 'pending'::connection_status_enum,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  note text,
  CONSTRAINT user_connections_pkey PRIMARY KEY (id),
  CONSTRAINT user_connections_requester_id_fkey FOREIGN KEY (requester_id) REFERENCES public.users(id),
  CONSTRAINT user_connections_recipient_id_fkey FOREIGN KEY (recipient_id) REFERENCES public.users(id)
);
CREATE TABLE public.user_details (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  user_id uuid,
  birth_date date,
  phone_number character varying,
  school_name text,
  additional_info jsonb NOT NULL DEFAULT '{}'::jsonb,
  profile_picture_url text,
  is_profile_picture_hidden boolean DEFAULT false,
  allow_connections boolean NOT NULL DEFAULT true,
  notification_preferences jsonb DEFAULT '{"social": true, "system": true, "committee": true, "application": true}'::jsonb,
  city text,
  grade USER-DEFINED,
  CONSTRAINT user_details_pkey PRIMARY KEY (id),
  CONSTRAINT user_details_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.users(id)
);
CREATE TABLE public.user_warnings (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  user_id uuid NOT NULL,
  issued_by uuid NOT NULL,
  reason text NOT NULL,
  created_at timestamp with time zone DEFAULT now(),
  category USER-DEFINED NOT NULL DEFAULT 'other'::warning_category_enum,
  CONSTRAINT user_warnings_pkey PRIMARY KEY (id),
  CONSTRAINT user_warnings_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.users(id),
  CONSTRAINT user_warnings_issued_by_fkey FOREIGN KEY (issued_by) REFERENCES public.users(id)
);
CREATE TABLE public.users (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  full_name character varying NOT NULL,
  email character varying NOT NULL UNIQUE,
  password_hash character varying NOT NULL,
  role character varying NOT NULL DEFAULT 'applicant'::character varying,
  created_at timestamp with time zone NOT NULL DEFAULT now(),
  updated_at timestamp with time zone,
  is_suspended boolean NOT NULL DEFAULT false,
  CONSTRAINT users_pkey PRIMARY KEY (id)
);
CREATE TABLE public.vote_options (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  vote_id uuid NOT NULL,
  label text NOT NULL,
  CONSTRAINT vote_options_pkey PRIMARY KEY (id),
  CONSTRAINT vote_options_vote_id_fkey FOREIGN KEY (vote_id) REFERENCES public.votes(id)
);
CREATE TABLE public.vote_responses (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  vote_id uuid NOT NULL,
  option_id uuid NOT NULL,
  user_id uuid NOT NULL,
  created_at timestamp with time zone DEFAULT now(),
  CONSTRAINT vote_responses_pkey PRIMARY KEY (id),
  CONSTRAINT vote_responses_vote_id_fkey FOREIGN KEY (vote_id) REFERENCES public.votes(id),
  CONSTRAINT vote_responses_option_id_fkey FOREIGN KEY (option_id) REFERENCES public.vote_options(id),
  CONSTRAINT vote_responses_user_id_fkey FOREIGN KEY (user_id) REFERENCES public.users(id)
);
CREATE TABLE public.votes (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  committee_id uuid NOT NULL,
  title text NOT NULL,
  status USER-DEFINED NOT NULL DEFAULT 'open'::vote_status_enum,
  created_at timestamp with time zone DEFAULT now(),
  CONSTRAINT votes_pkey PRIMARY KEY (id),
  CONSTRAINT votes_committee_id_fkey FOREIGN KEY (committee_id) REFERENCES public.committees(id)
);