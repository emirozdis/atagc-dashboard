# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Prisma's server-side PostgreSQL connection. Never expose this to the browser.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"
# Session/direct connection for Prisma introspection and migrations.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"
SUPABASE_PROJECT_PASSWORD="..."
# Set to false only for local networks that replace the Supabase CA certificate.
DATABASE_SSL_REJECT_UNAUTHORIZED="true"

# Get these from your Supabase Project Settings -> API
# URL of your Supabase project
NEXT_PUBLIC_SUPABASE_URL="https://....supabase.co"

# Anon Key (Public) - Safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY="...8QQWc"

# Secret API key (Secret) - NEVER expose this to the browser.
# Used only for Supabase Storage; database reads/writes use Prisma and DATABASE_URL.
# Create an `sb_secret_...` key in Supabase Project Settings -> API Keys.
SUPABASE_SECRET_KEY="sb_secret_..."
# Legacy fallback only while migrating an existing deployment:
# SUPABASE_SECRET_SERVICE_ROLE_KEY="..."

# -----------------------------------------------------------------------------
# NEXTAUTH CONFIGURATION
# -----------------------------------------------------------------------------
# The canonical URL of your site. In development, this is localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# A random string used to hash tokens. You can generate one via `openssl rand -base64 32`
NEXTAUTH_SECRET="...h6A="

SUPABASE_JWT_SECRET="...e99Iyg=="

# -----------------------------------------------------------------------------
# COLLABORATION SERVER (Hocuspocus)
# -----------------------------------------------------------------------------
# The port where the websocket server for the text editor will run.
# Used in ./collab-server/hocuspocus-server.ts
COLLAB_PORT=1234
NEXT_PUBLIC_COLLAB_PORT=1234

# Shared rate limiting (recommended for Vercel/serverless deployments)
UPSTASH_REDIS_REST_URL="https://....upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."
# Local automated tests only. Never enable this on a multi-instance deployment.
RATE_LIMIT_ALLOW_MEMORY_FALLBACK="false"


# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION
# -----------------------------------------------------------------------------
# Resend is recommended for RavenMUN. SMTP remains available as a fallback.
RESEND_API_KEY="re_..."
EMAIL_FROM='"RavenMUN" <no-reply@ravenmun.org>'

# Local-only escape hatch when SMTP is unavailable. Never enable in production.
EMAIL_DEV_MODE="false"

SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="...@smtp-brevo.com"
SMTP_PASS="...."

# -----------------------------------------------------------------------------
# CloudFlare Turnstile Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x..."
TURNSTILE_SECRET_KEY="0x..."
# Standalone WebSocket service (deploy separately from Vercel)
COLLAB_PORT=1234
NEXT_PUBLIC_COLLAB_URL=ws://localhost:1234
# Optional dedicated signing secret; defaults to NEXTAUTH_SECRET.
COLLAB_AUTH_SECRET=""
