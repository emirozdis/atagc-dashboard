# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Prisma's server-side PostgreSQL connection. Never expose this to the browser.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"
DATABASE_SSL_REJECT_UNAUTHORIZED="false"

# Used only for server-side Supabase Storage; database reads/writes use Prisma.
NEXT_PUBLIC_SUPABASE_URL="https://....supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."

# -----------------------------------------------------------------------------
# SITE AND NEXTAUTH
# -----------------------------------------------------------------------------
# Canonical public HTTPS URL. Required in production. No trailing slash.
NEXTAUTH_URL="https://ravenmun.com"
NEXT_PUBLIC_SITE_URL="https://ravenmun.com"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="..."

SUPABASE_JWT_SECRET="..."

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_ALLOW_MEMORY_FALLBACK="true"

# -----------------------------------------------------------------------------
# EMAIL
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_..."
# Full Access is required to retrieve received email content.
# Signing secret for https://ravenmun.com/api/webhooks/resend (`email.received`).
RESEND_WEBHOOK_SECRET="whsec_..."
EMAIL_FROM='"RavenMUN" <no-reply@ravenmun.com>'
EMAIL_DEV_MODE="false"

# -----------------------------------------------------------------------------
# CLOUDFLARE TURNSTILE
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x..."
TURNSTILE_SECRET_KEY="0x..."

# -----------------------------------------------------------------------------
# COLLABORATION SERVER (deploy separately)
# -----------------------------------------------------------------------------
COLLAB_PORT=1234
NEXT_PUBLIC_COLLAB_URL="wss://collab.ravenmun.com"
COLLAB_AUTH_SECRET=""
