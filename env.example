# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Prisma's server-side PostgreSQL connection. Never expose this to the browser.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"
# Session/direct connection for Prisma introspection and migrations.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"
SUPABASE_PROJECT_PASSWORD="..."
# Set to false only for local networks that replace the Supabase CA certificate.
DATABASE_SSL_REJECT_UNAUTHORIZED="true"

# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://....supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
# Used only for Supabase Storage; database reads/writes use Prisma and DATABASE_URL.
SUPABASE_SECRET_KEY="sb_secret_..."

# -----------------------------------------------------------------------------
# SITE AND NEXTAUTH
# -----------------------------------------------------------------------------
# Canonical public HTTPS URL. Required in production. No trailing slash.
NEXTAUTH_URL="https://ravenmun.org"
NEXT_PUBLIC_SITE_URL="https://ravenmun.org"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="..."

SUPABASE_JWT_SECRET="..."

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
# Required in production. Do not set RATE_LIMIT_ALLOW_MEMORY_FALLBACK=true on Vercel.
UPSTASH_REDIS_REST_URL="https://....upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."
RATE_LIMIT_ALLOW_MEMORY_FALLBACK="false"

# -----------------------------------------------------------------------------
# EMAIL
# -----------------------------------------------------------------------------
# Resend is recommended. SMTP remains a fallback if RESEND_API_KEY is unset.
RESEND_API_KEY="re_..."
EMAIL_FROM='"RavenMUN" <no-reply@ravenmun.org>'
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="..."
SMTP_PASS="...."
# Keep the outbox worker running in production: pnpm run email:worker
EMAIL_OUTBOX_BATCH_SIZE="25"
EMAIL_OUTBOX_INTERVAL_MS="5000"

# -----------------------------------------------------------------------------
# CLOUDFLARE TURNSTILE
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x..."
TURNSTILE_SECRET_KEY="0x..."

# -----------------------------------------------------------------------------
# COLLABORATION SERVER (deploy separately)
# -----------------------------------------------------------------------------
COLLAB_PORT=1234
NEXT_PUBLIC_COLLAB_URL="wss://collab.ravenmun.org"
COLLAB_AUTH_SECRET=""
