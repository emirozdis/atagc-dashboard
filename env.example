# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Get these from your Supabase Project Settings -> API
# URL of your Supabase project
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Anon Key (Public) - Safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Service Role Key (Secret) - NEVER expose this to the browser. 
# Used in ./lib/SERVER_supabase.ts for admin tasks (bypassing RLS).
SUPABASE_SECRET_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# -----------------------------------------------------------------------------
# NEXTAUTH CONFIGURATION
# -----------------------------------------------------------------------------
# The canonical URL of your site. In development, this is localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# A random string used to hash tokens. You can generate one via `openssl rand -base64 32`
NEXTAUTH_SECRET="super-secret-random-string-at-least-32-chars"

SUPABASE_JWT_SECRET="***"


# -----------------------------------------------------------------------------
# COLLABORATION SERVER (Hocuspocus)
# -----------------------------------------------------------------------------
# The port where the websocket server for the text editor will run.
# Used in ./collab-server/hocuspocus-server.ts
COLLAB_PORT=1234